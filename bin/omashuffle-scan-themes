#!/usr/bin/env python3

# omarchy:summary=List installed Omarchy themes with a small palette preview (read-only)
#
# Emits a JSON array, one object per installed theme:
#   {"slug","source"("user"|"system"),"display","accent","background","foreground","colors":[hex,...]}
#
# Themes are read from the two standard locations; a user theme shadows a system
# theme with the same slug. Every read is bounded and descriptor-safe: a theme
# (which may be an installed third-party repo) cannot make this block or grow the
# shell. Nothing here executes or writes anything. On any trouble it prints "[]".

import json
import os
import re
import signal
import stat
import sys

MAX_THEMES = 500          # far above any real installed-theme count
MAX_SLUG = 128            # matches omarchy-theme-set's own id length cap
MAX_COLORS_BYTES = 65536  # a colors.toml is a few hundred bytes; this is generous
DEADLINE_SEC = 10

SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")
HEX_LINE_RE = re.compile(r'^[ \t]*([A-Za-z_][A-Za-z0-9_]*)[ \t]*=[ \t]*"(#[0-9A-Fa-f]{3,8})"', re.M)
SWATCH_KEYS = ("red", "green", "blue", "yellow", "magenta", "cyan")


def _give_up(*_):
    sys.stdout.write("[]\n")
    os._exit(0)


def read_palette(path):
    """Read at most MAX_COLORS_BYTES from a regular file, never following a
    symlink and never blocking on a FIFO. Returns {key: hex}."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return {}
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return {}
        chunks, total = [], 0
        while total < MAX_COLORS_BYTES:
            try:
                b = os.read(fd, MAX_COLORS_BYTES - total)
            except (BlockingIOError, OSError):
                break
            if not b:
                break
            chunks.append(b)
            total += len(b)
    finally:
        os.close(fd)
    text = b"".join(chunks).decode("utf-8", "replace")
    out = {}
    for key, value in HEX_LINE_RE.findall(text):
        out.setdefault(key, value)
    return out


def display_name(slug):
    return " ".join(w.capitalize() for w in re.split(r"[-_]", slug) if w)


def main():
    signal.signal(signal.SIGALRM, _give_up)
    signal.alarm(DEADLINE_SEC)

    home = os.environ.get("HOME", "")
    omarchy_path = os.environ.get("OMARCHY_PATH", "/usr/share/omarchy")
    sources = [
        (os.path.join(home, ".config", "omarchy", "themes"), "user"),
        (os.path.join(omarchy_path, "themes"), "system"),
    ]

    themes = []
    seen = set()
    for base, source in sources:
        try:
            names = sorted(os.listdir(base))
        except OSError:
            continue
        for name in names:
            if len(themes) >= MAX_THEMES:
                break
            if len(name) > MAX_SLUG or not SLUG_RE.match(name) or name in seen:
                continue
            themedir = os.path.join(base, name)
            if not os.path.isdir(themedir):
                continue
            seen.add(name)
            palette = read_palette(os.path.join(themedir, "colors.toml"))
            themes.append({
                "slug": name,
                "source": source,
                "display": display_name(name),
                "accent": palette.get("accent", ""),
                "background": palette.get("background", ""),
                "foreground": palette.get("foreground", ""),
                "colors": [palette[k] for k in SWATCH_KEYS if k in palette],
            })

    json.dump(themes, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.stdout.write("[]\n")
        sys.exit(0)
